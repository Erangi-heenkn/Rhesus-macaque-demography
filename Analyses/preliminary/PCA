#### Rscript for plot
setwd("C:/era/ASU/Rhesus project/Preliminary results/pca")

library(ggplot2)

# Read eigenvec file
pca <- read.table("pca_results.eigenvec", header = FALSE)
colnames(pca) <- c("FID", "IID", paste0("PC", 1:(ncol(pca) - 2)))

pop <- read.table("populations.txt", header = TRUE)

# Merge on IID
pca <- merge(pca, pop, by = "IID")

X<-ggplot(pca, aes(x = PC1, y = PC2, fill = population)) +
  geom_point(shape = 21, size = 3, alpha = 0.5, color = "black") +  
  geom_text_repel(aes(label = IID), size = 3) +  scale_fill_manual(values = c("China" = "red4", "India" = "#2c3e50")) +
  theme_classic() +  # removes background grid and gray background
  theme(
    panel.grid = element_blank(),  # just in case
    legend.title = element_blank()
  ) +
  labs(title = "Rhesus PCA for demographic data set", x = "PC1", y = "PC2")

Y<-X+ xlab(paste0("PC1 (", round(100 * pve[1], 1), "%)")) +
  ylab(paste0("PC2 (", round(100 * pve[2], 1), "%)")) 

